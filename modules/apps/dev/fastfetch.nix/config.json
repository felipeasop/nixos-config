{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "nixos",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    },
    "color": {
      "1": "#7fbbb3",
      "2": "#a7c080",
      "3": "#7fbbb3",
      "4": "#a7c080",
      "5": "#7fbbb3",
      "6": "#a7c080"
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "\u001b[38;2;127;187;179m{user-name}\u001b[38;2;90;90;80m@\u001b[38;2;167;192;128m{host-name}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;127;187;179m╭─  Sistema"
    },
    {
      "type": "os",
      "key": "\u001b[38;2;127;187;179m├─ \u001b[38;2;167;192;128m",
      "keyColor": "default",
      "format": "NixOS {version}"
    },
    {
      "type": "kernel",
      "key": "\u001b[38;2;127;187;179m├─ \u001b[38;2;214;153;182m",
      "keyColor": "default",
      "format": "{release}"
    },
    {
      "type": "packages",
      "key": "\u001b[38;2;127;187;179m├─ \u001b[38;2;167;192;128m",
      "keyColor": "default",
      "format": "{all}"
    },
    {
      "type": "uptime",
      "key": "\u001b[38;2;127;187;179m╰─ \u001b[38;2;219;188;127m",
      "keyColor": "default"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;127;187;179m╭─  Hardware"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;2;127;187;179m├─ \u001b[38;2;230;152;117m",
      "keyColor": "default",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "\u001b[38;2;127;187;179m├─ \u001b[38;2;230;152;117m",
      "keyColor": "default",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "\u001b[38;2;127;187;179m├─ \u001b[38;2;230;152;117m",
      "keyColor": "default"
    },
    {
      "type": "disk",
      "key": "\u001b[38;2;127;187;179m╰─ \u001b[38;2;230;152;117m",
      "keyColor": "default",
      "folders": "/"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;127;187;179m╭─  Ambiente"
    },
    {
      "type": "de",
      "key": "\u001b[38;2;127;187;179m├─ \u001b[38;2;131;192;146m",
      "keyColor": "default"
    },
    {
      "type": "shell",
      "key": "\u001b[38;2;127;187;179m├─ \u001b[38;2;131;192;146m",
      "keyColor": "default"
    },
    {
      "type": "terminal",
      "key": "\u001b[38;2;127;187;179m╰─ \u001b[38;2;131;192;146m",
      "keyColor": "default"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    },
    "break"
  ]
}
